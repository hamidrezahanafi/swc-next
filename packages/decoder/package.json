{
  "name": "@swc-next/decoder",
  "version": "0.2.3",
  "description": "Decode SWC Next native parser output into ESTree",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/swc-project/swc-next.git",
    "directory": "packages/decoder"
  },
  "main": "index.js",
  "type": "module",
  "sideEffects": false,
  "types": "./index.d.ts",
  "exports": {
    ".": {
      "import": "./index.js",
      "types": "./index.d.ts"
    },
    "./lazy": {
      "types": "./lazy/index.d.ts",
      "import": "./lazy/index.js"
    }
  },
  "files": [
    "index.d.ts",
    "index.js",
    "options.js",
    "decode-js.js",
    "decode-ts.js",
    "README.md",
    "lazy/index.js",
    "lazy/index.d.ts",
    "lazy/lazy-common.js",
    "lazy/node-array.js",
    "lazy/decode-js.js",
    "lazy/decode-ts.js"
  ],
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "keywords": [
    "ast",
    "estree",
    "javascript",
    "swc",
    "typescript"
  ],
  "license": "Apache-2.0"
}
